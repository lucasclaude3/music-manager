{
  "name": "music-manager",
  "version": "0.0.1",
  "author": "kahlua <lucasclaude3@gmail.com>",
  "description": "An Electron-Vue project for managing your music easily",
  "license": null,
  "main": "./dist/electron/main.js",
  "scripts": {
    "build": "node .electron-vue/build.js && electron-builder",
    "build:dir": "node .electron-vue/build.js && electron-builder --dir",
    "build:clean": "cross-env BUILD_TARGET=clean node .electron-vue/build.js",
    "build:web": "cross-env BUILD_TARGET=web node .electron-vue/build.js",
    "dev": "node .electron-vue/dev-runner.js",
    "e2e": "yarn run pack && mocha test/e2e",
    "lint": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter src test",
    "lint:fix": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter --fix src test",
    "pack": "yarn run pack:main && yarn run pack:renderer",
    "pack:main": "cross-env NODE_ENV=production webpack --progress --colors --config .electron-vue/webpack.main.config.js",
    "pack:renderer": "cross-env NODE_ENV=production webpack --progress --colors --config .electron-vue/webpack.renderer.config.js",
    "test": "yarn run unit && yarn run e2e",
    "unit": "karma start test/unit/karma.conf.js",
    "postinstall": "echo 'Skipping lint:fix for now'",
    "generate-icons": "vsvg -s ./src/renderer/assets/svg-icons -t ./src/renderer/assets/compiled-icons"
  },
  "build": {
    "productName": "music-manager",
    "appId": "com.example.yourapp",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/electron/**/*"
    ],
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "mac": {
      "icon": "build/icons/icon.icns"
    },
    "win": {
      "icon": "build/icons/icon.ico"
    },
    "linux": {
      "icon": "build/icons"
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.27.6",
    "axios": "^0.21.1",
    "bluebird": "^3.7.2",
    "bootstrap": "^4.6.0",
    "bootstrap-vue": "^2.21.2",
    "bulksearch": "^0.1.3",
    "dataurl": "^0.1.0",
    "dotenv": "^10.0.0",
    "electron": "^22.0.0",
    "electron-store": "^8.1.0",
    "fs": "^0.0.1-security",
    "howler": "^2.2.3",
    "mime-db": "^1.52.0",
    "mime-type": "^3.0.7",
    "node-id3": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "uuid": "^8.3.2",
    "vue": "^2.6.14",
    "vue-electron": "^1.0.6",
    "vue-js-modal": "^2.0.0-rc.3",
    "vue-router": "^3.5.3",
    "vue-svgicon": "^3.2.6",
    "vue-youtube": "^1.4.0",
    "vuex": "^3.6.2",
    "vuex-electron": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.18.0",
    "@babel/eslint-parser": "^7.18.0",
    "@babel/plugin-transform-runtime": "^7.18.0",
    "@babel/preset-env": "^7.18.0",
    "ajv": "^6.12.6",
    "babel-loader": "^8.2.5",
    "babel-plugin-istanbul": "^6.1.1",
    "babel-register": "^6.26.0",
    "babili-webpack-plugin": "^0.1.2",
    "cfonts": "^2.10.0",
    "chai": "^4.3.6",
    "chalk": "^4.1.2",
    "copy-webpack-plugin": "^9.1.0",
    "cross-env": "^7.0.3",
    "css-loader": "^3.6.0",
    "del": "^6.1.0",
    "devtron": "^1.4.0",
    "electron-builder": "^23.0.0",
    "electron-debug": "^3.2.0",
    "electron-devtools-installer": "^3.2.0",
    "eslint": "^8.15.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-import-resolver-webpack": "^0.13.0",
    "eslint-plugin-html": "^6.2.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-vue": "^8.7.0",
    "eslint-webpack-plugin": "^3.2.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "inject-loader": "^4.0.0",
    "karma": "^6.4.0",
    "karma-chai": "^0.1.0",
    "karma-coverage": "^2.2.0",
    "karma-electron": "^7.3.0",
    "karma-sourcemap-loader": "^0.3.8",
    "karma-spec-reporter": "^0.0.34",
    "karma-webpack": "^5.0.0",
    "mini-css-extract-plugin": "^2.6.0",
    "mocha": "^9.2.0",
    "node-loader": "^2.0.0",
    "ora": "^5.4.1",
    "require-dir": "^1.2.0",
    "sass": "^1.32.0",
    "sass-loader": "^7.3.1",
    "spectron": "^19.0.0",
    "style-loader": "^1.3.0",
    "url-loader": "^4.1.1",
    "vue-html-loader": "^1.2.4",
    "vue-loader": "^15.9.0",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "^2.6.14",
    "webpack": "^5.72.0",
    "webpack-cli": "^4.9.0",
    "webpack-dev-server": "^4.7.0",
    "webpack-hot-middleware": "^2.25.0",
    "webpack-merge": "^5.8.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "yarn": ">=1.22.0"
  }
}
